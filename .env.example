# Generate a random value of at least 32 characters and keep it private.
# Leave it blank instead to disable authentication entirely - only safe when
# Lantern is reachable exclusively via localhost or a trusted VPN (Tailscale,
# WireGuard, ...).
LANTERN_API_KEY=replace-with-a-random-32-character-secret

# Optional: expose the frontend on additional origins during development.
LANTERN_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
